{
  "name": "taking-poster-photos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first, offline-capable PWA for photographing scientific posters and viewing them rectified and in high resolution.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "dev:tunnel": "vite --mode tunnel",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:tunnel": "vite preview --mode tunnel",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "pwa-assets-generator --preset minimal-2023 public/icons/icon.svg"
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "idb": "8.0.4",
    "pdf-lib": "1.17.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-build": "7.4.1"
  }
}
